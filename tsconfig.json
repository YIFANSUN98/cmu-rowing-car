{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "google.maps"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", "tests", "server", "cloud", "*.config.ts"]
}
